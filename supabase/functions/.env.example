# Supabase Edge Function secrets. Do not put real values in tracked files.
PHYS_EMAIL_BRIDGE_SECRET=<same-random-secret-as-backend-CUSTOMER_EMAIL_BRIDGE_SECRET-at-least-32-characters>
# Optional: when set, outgoing emails use Brevo (free 300/day to any recipient, no custom domain needed).
BREVO_API_KEY=<brevo-v3-api-key-for-sending>
# Used for Resend Receiving (inbound replies) and as fallback sender when BREVO_API_KEY is unset.
RESEND_API_KEY=<resend-full-access-key-for-receive-or-fallback-send>
CUSTOMER_EMAIL_FROM=PhysLive <your-verified-sender@gmail.com>
CUSTOMER_EMAIL_REPLY_DOMAIN=<your-inbound-subdomain-or-account-id.resend.app>
